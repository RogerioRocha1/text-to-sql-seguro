# Copie para .env e ajuste se precisar. Nenhuma chave de API é necessária.

# Endereço do Ollama (no Docker Compose será http://ollama:11434)
OLLAMA_URL=http://localhost:11434

# Modelo usado para gerar SQL e explicações
OLLAMA_MODELO=qwen2.5-coder:7b

# Caminho do banco DuckDB gerado pelo script de carga
DUCKDB_CAMINHO=data/despesas.duckdb

# Máximo de linhas devolvidas por consulta
LIMITE_LINHAS=1000
