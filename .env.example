# Copie para .env e ajuste se precisar. Nenhuma chave de API é necessária.
# O banco só escuta em 127.0.0.1; ainda assim, troque as senhas abaixo.

# Endereço do Ollama (no Docker Compose será http://ollama:11434)
OLLAMA_URL=http://localhost:11434

# Modelo usado para gerar SQL e explicações
OLLAMA_MODELO=qwen2.5-coder:7b

# PostgreSQL: usuário dono (usado só pela carga) e usuário somente leitura (usado pela aplicação)
POSTGRES_DB=despesas
POSTGRES_USER=carga
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_LEITOR_USUARIO=leitor
POSTGRES_LEITOR_SENHA=troque-esta-senha-tambem
POSTGRES_PORTA=5432

# Ano dos dados do Portal da Transparência
ANO_DADOS=2025

# Máximo de linhas devolvidas por consulta
LIMITE_LINHAS=1000
