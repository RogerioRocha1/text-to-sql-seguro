# Copie para .env e ajuste se precisar. Nenhuma chave de API é necessária.
# O banco só escuta em 127.0.0.1; ainda assim, troque as senhas abaixo.

# Endereço do Ollama visto de fora do Docker (dentro do compose, a aplicação usa http://ollama:11434)
OLLAMA_URL=http://localhost:11434
OLLAMA_PORTA=11434

# Modelo que gera o SQL. O 3b (1,9 GB, ~2,2 GB de memória) é o padrão e o usado na
# avaliação. O 7b (4,7 GB, ~5,5 GB de memória) só vale com GPU NVIDIA de 6 GB ou mais:
# na CPU leva o dobro do tempo e não cabe no Docker de máquinas com 8 GB. Ele não foi
# avaliado no benchmark, então não há medida de que acerte mais.
OLLAMA_MODELO=qwen2.5-coder:3b

# Tamanho do contexto (tokens). O prompt com o esquema usa ~1.650; 4096 sobra.
OLLAMA_CONTEXTO=4096

# Tempo que o modelo fica carregado sem uso (descarregar obriga a reler o esquema).
OLLAMA_KEEP_ALIVE=1h

# GPU NVIDIA (opcional): descomente a linha do seu sistema
# COMPOSE_FILE=docker-compose.yml;docker-compose.gpu.yml
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml

# PostgreSQL: usuário dono (usado só pela carga) e usuário somente leitura (usado pela aplicação)
POSTGRES_DB=despesas
POSTGRES_USER=carga
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_LEITOR_USUARIO=leitor
POSTGRES_LEITOR_SENHA=troque-esta-senha-tambem
POSTGRES_PORTA=5432

# Ano dos dados do Portal da Transparência
ANO_DADOS=2025

# Porta da interface de chat (http://localhost:8501)
APP_PORTA=8501

# Máximo de linhas devolvidas por consulta
LIMITE_LINHAS=1000

# Custo máximo estimado pelo EXPLAIN do PostgreSQL (calibração em eval/README.md)
CUSTO_MAXIMO=1000000
